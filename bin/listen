#!/bin/sh
# Both modes use the same signed application bundle and on-device data.
set -eu
source_path=$0
while [ -L "$source_path" ]; do
  link_dir=$(CDPATH= cd -- "$(dirname -- "$source_path")" && pwd)
  source_path=$(readlink "$source_path")
  case "$source_path" in /*) ;; *) source_path="$link_dir/$source_path" ;; esac
done
repo_root=$(CDPATH= cd -- "$(dirname -- "$source_path")/.." && pwd)
app=${LISTEN_APP:-}
if [ -z "$app" ]; then
  for candidate in \
    "$repo_root/ios/build/cli/Build/Products/Debug-maccatalyst/Listen.app" \
    "/Applications/Listen.app" \
    "$HOME/Applications/Listen.app"; do
    if [ -x "$candidate/Contents/MacOS/Listen" ]; then app=$candidate; break; fi
  done
fi
if [ -z "$app" ] || [ ! -x "$app/Contents/MacOS/Listen" ]; then
  echo 'Listen.app was not found. Build it with ios/Tools/build-cli.sh, or set LISTEN_APP to its path.' >&2
  exit 1
fi
mode=-gui
case "${1:-}" in
  -gui|-cli) mode=$1; shift ;;
  --help|-h) mode=-cli ;;
  '') ;;
  *) echo 'Use listen -gui or listen -cli. See listen -cli --help.' >&2; exit 2 ;;
esac
for argument in "$@"; do
  case "$argument" in -cli|-gui) echo 'Choose one interface: -gui or -cli.' >&2; exit 2 ;; esac
done
if [ "$mode" = -cli ]; then
  version=$(/usr/libexec/PlistBuddy -c 'Print :ListenCommandLineVersion' "$app/Contents/Info.plist" 2>/dev/null || true)
  if [ "$version" != 1 ]; then
    echo 'This Listen build does not support the CLI. Rebuild with ios/Tools/build-cli.sh.' >&2
    exit 1
  fi
  exec "$app/Contents/MacOS/Listen" -cli "$@"
fi
exec /usr/bin/open -n -F "$app" --args -gui "$@"
